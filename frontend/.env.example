# Optional local research archive locations. Never expose private session directories.
# HADITH_DATA_DIR=/absolute/path/to/hadith-reclassifier/data/hadiths
# TELEGRAM_ARCHIVE_DIR=/absolute/path/to/telegram-archive/kkee9938

# Hosting: public evidence objects and public corpus JSON; no storage credentials needed by the website.
# MEDIA_PUBLIC_BASE_URL=https://your-media-domain.example/othmani
# CORPUS_DATA_BASE_URL=https://your-media-domain.example/othmani/corpus

# Published snapshots are the default. Explicitly opt in only for intentional live corpus reads.
RESEARCH_DATA_SOURCE=snapshot
# RESEARCH_DATA_SOURCE=neon
# Server-only restricted Neon reader, never a NEXT_PUBLIC variable.
RESEARCH_READ_DATABASE_URL=
