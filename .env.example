# OpenAI API — set a private key in .env, never in source control
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini

# Optional Sunnah.com API
SUNNAH_API_KEY=

# Database (Docker default; preserve your existing URL for local runs)
DATABASE_URL=postgresql://hadith:hadith@db:5432/hadith_db

# Research storage (server only). Originals live in a public R2 app prefix.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_PREFIX=othmani
MEDIA_PUBLIC_BASE_URL=
CORPUS_DATA_BASE_URL=
HADITH_DATA_DIR=
TELEGRAM_ARCHIVE_DIR=

# Dedicated Neon research database; not connected until provisioning and migration.
# DATABASE_URL above belongs to the existing experimental backend.
RESEARCH_POSTGRES_URL=
RESEARCH_DATABASE_PROVIDER=neon
NEON_PROJECT_ID=
NEON_DATABASE_HOST=
